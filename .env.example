# Copia este archivo como .env.local y completa los valores.
# Si dejas vacías las variables de Supabase, el sitio muestra productos de ejemplo.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Número de WhatsApp con código de país, sin + ni espacios (ej: 56912345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=56900000000
